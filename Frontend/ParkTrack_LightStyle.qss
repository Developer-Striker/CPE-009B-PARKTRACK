/* Application & Container Frames */
QMainWindow {
    background-color: #ffffff;
}

QFrame#rSidebar {
    background-color: #F2F4F6;
    border-radius: 6px;
    border: 1px solid #F0F0F0;
}

/* Header Banner */
QFrame#Banner {
    background-color: #F2F4F6;
    border-radius: 6px;
    border: 1px solid #F0F0F0;
}

QLabel#Logo {
    background-color: transparent;
    color: transparent;
    font-size: 20px;
    font-weight: bold;
    border-radius: 4px;
    border: 1px solid yellow;
}

QLabel#bannerTitle {
    color: #000000;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
    border: none;
}

QFrame#bannerBox {
    background-color: #ffffff;
    border: 1px solid #F0F0F0;
    border-radius: 4px;
}

QLabel#lblC {
    color: #000000;
    font-size: 11px;
    background: #ffffff;
    border: none;
}

/* Map Filter Controls */
QLabel#mapFilter {
    color: #000000;
    font-size: 14px;
    font-weight: bold;
    border: none;
}

QPushButton#viewAll {
    background-color: #F2F4F6;
    color: #949191;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: none;
}

QPushButton#viewAvail {
    background-color: #E8F5E9;
    color: #2E7D32;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: 2px #F0F0F0;
}

QPushButton#viewOcc {
    background-color: #FFEBEE;
    color: #C62828;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: 2px #F0F0F0;
}

/* Map Grid & Parking Cards */
QScrollArea#scrollArea {
    border: 1px solid #ffffff;
    border-radius: 6px;
    background-color: #f4f4f4;
}

QFrame#frame {
    background-color: #F2F4F6;
    border: none;
}

QFrame#slotCard {
    background-color: #ECEFF1;
    border: 1px solid #F0F0F0;
    border-radius: 4px;
}

QPushButton#action {
    background-color: #ffffff;
    color: #000000;
    font-size: 10px;
    border-radius: 2px;
    padding: 2px;
    border: none;
}

QPushButton#action::hover {
    background-color: #ffffff;
    color: #000000;
    font-size: 10px;
    border-radius: 2px;
    padding: 2px;
    border: none;
}

QFrame#roadway {
    background-color: #ECEFF1;
    border-top: 1px dashed #ffffff;
    border-bottom: 1px dashed #ffffff;
}

/* Control Tabs */
QTabWidget::pane {
    border: 2px solid #F0F0F0;
    background: #F9FAFA;
    border-radius: 4px;
}

QTabBar::tab {
    background: #F9FAFA;
    color: #000000;
    padding: 8px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    border: 1px solid #F0F0F0;
}

QTabBar::tab:selected {
    background: #F0F0F0;
    color: #000000;
    font-weight: 800;
    border-bottom-color: transparent;
}

/* Input Fields & Combos */
QLineEdit#panelInput, QComboBox#panelCombo {
    background-color: #fff;
    color: black;
    border: 1px solid #F0F0F0;
    padding: 5px;
    border-radius: 3px;
}

QSpinBox#panelSpin {
    background-color: #f4f4f4;
    color: #000;
    padding: 3px;
    border: 1px solid #F0F0F0;
    border-radius: 3px;
}

QCheckBox#overstay {
    color: #aaa;
    font-size: 11px;
}

QPushButton#assign {
    background-color: #ECEFF1;
    color: #949191;
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;
    margin-top: 5px;
    border: none;
}

QLabel#section {
    color: #000000;
    font-size: 14px;
    font-weight: bold;
    border: none;
}

/* Smaller QLabel custom */
QLabel#sub_section {
    color: #000000;
    font-size: 12px;
    border: none;
}

/* NEW QPushButton */
QPushButton#Theme {
    background: transparent;
    background-color: transparent;
    border: none;
    padding: 4px 8px;
    font-size: 20px;
}

QFrame#rate {
    background-color: #F2F4F6;
    border: 1px solid #F0F0F0;
    border-radius: 4px;
}

QPushButton#checkoutBtn {
    background-color: #ECEFF1;
    color: #949191;
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;
    margin-top: 5px;
    border: none;
}

/* Session History Matrix */
QTableWidget#ticketLog {
    background-color: #ffffff;
    color: #000000;
    gridline-color: #E6E9ED;
    font-size: 11px;
    border: 1px solid #F0F0F0;
}

QHeaderView::section {
    background-color: #E6E9ED;
    color: #000000;
    padding: 4px;
    border: 1px solid #F0F0F0;
    font-size: 11px;
}

/* Activity Log */
QLabel#logTitle {
    color: #000000;
    font-size: 14px;
    font-weight: bold;
    border: none;
    padding-top: 5px;
}

QTextEdit#activityLogBox {
    background-color: #ffffff;
    color: #2E7D32;
    border: 1px solid #F0F0F0;
    font-family: JetBrains Mono;
    font-size: 13px;
    border-radius: 4px;
}

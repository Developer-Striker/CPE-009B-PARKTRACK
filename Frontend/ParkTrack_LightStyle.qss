/* Application & Container Frames */
QMainWindow {
    background-color: #eaeaea;
}

QFrame#rSidebar {
    background-color: #dddddd;
}

/* Header Banner */
QFrame#Banner {
    background-color: #dddddd;
}

QLabel#Logo {
    background-color: #1e1e1e;
    color: #f1c40f;
    font-size: 20px;
    font-weight: bold;
    border-radius: 4px;
    border: 1px solid yellow;
}

QLabel#bannerTitle {
    color: #000000;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
    border: none;
}

QFrame#bannerBox {
    background-color: #f4f4f4;
    border: 1px solid #ffffff;
    border-radius: 4px;
}

QLabel#lblC {
    color: #000000;
    font-size: 10px;
    background: #f4f4f4;
    border: none;
}

/* Map Filter Controls */
QLabel#mapFilter {
    color: #000000;
    font-size: 12px;
    font-weight: bold;
    border: none;
}

QPushButton#viewAll {
    background-color: #7f8c8d;
    color: #ffffff;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: none;
}

QPushButton#viewAvail {
    background-color: #2ecc71;
    color: #ffffff;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: none;
}

QPushButton#viewOcc {
    background-color: #e74c3c;
    color: #ffffff;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: none;
}

/* Map Grid & Parking Cards */
QScrollArea#scrollArea {
    border: 1px solid #ffffff;
    border-radius: 6px;
    background-color: #f4f4f4;
}

QFrame#frame {
    background-color: #f4f4f4;
    border: none;
}

QFrame#slotCard {
    background-color: #eaeaea;
    border: 1px solid #ffffff;
    border-radius: 4px;
}

QPushButton#action {
    background-color: #c8c8c8;
    color: #000000;
    font-size: 10px;
    border-radius: 2px;
    padding: 2px;
    border: none;
}

QFrame#roadway {
    background-color: #eeeeee;
    border-top: 1px dashed #777777;
    border-bottom: 1px dashed #777777;
}

/* Control Tabs */
QTabWidget::pane {
    border: 2px solid #ffffff;
    background: #eaeaea;
    border-radius: 4px;
}

QTabBar::tab {
    background: #eaeaea;
    color: #000000;
    padding: 8px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    border: 1px solid #ffffff;
}

QTabBar::tab:selected {
    background: #c8c8c8;
    color: #000000;
    font-weight: 850;
    border-bottom-color: transparent;
}

/* Input Fields & Combos */
QLineEdit#panelInput, QComboBox#panelCombo {
    background-color: #c8c8c8;
    color: black;
    border: 1px solid #fff;
    padding: 5px;
    border-radius: 3px;
}

QSpinBox#panelSpin {
    background-color: #f4f4f4;
    color: #ffffff;
    padding: 3px;
    border: 1px solid #ffffff;
    border-radius: 3px;
}

QCheckBox#overstay {
    color: #aaa;
    font-size: 11px;
}

QPushButton#assign {
    background-color: #2980b9;
    color: #ffffff;
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;
    margin-top: 5px;
    border: none;
}

/* Combined all QLabel Tabs */
QLabel#Allocation, QLabel#section, QLabel#section2 {
    color: #000000;
    font-size: 13px;
    font-weight: bold;
    border: none;
}

/* NEW QPushButton */
QPushButton#Theme {
    background: transparent;
    background-color: transparent;
    border: none;
    padding: 4px 8px;
}

QPushButton#Theme:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}

QFrame#rate {
    background-color: #eaeaea;
    border: 1px solid #ffffff;
    border-radius: 4px;
}

QPushButton#checkoutBtn {
    background-color: #e74c3c;
    color: #ffffff;
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;
    margin-top: 5px;
    border: none;
}

/* Session History Matrix */
QTableWidget#ticketLog {
    background-color: #eaeaea;
    color: #000000;
    gridline-color: #c8c8c8;
    font-size: 11px;
    border: 1px solid #ffffff;
}

QHeaderView::section {
    background-color: #ababab;
    color: #ffffff;
    padding: 4px;
    border: 1px solid #ffffff;
    font-size: 11px;
}

/* Activity Log */
QLabel#logTitle {
    color: #000000;
    font-size: 12px;
    font-weight: bold;
    border: none;
    padding-top: 5px;
}

QTextEdit#activityLogBox {
    background-color: #fbfbfb;
    color: #2ecc71;
    border: 1px solid #ffffff;
    font-family: JetBrains Mono;
    font-size: 14px;
    border-radius: 4px;
}
/* Application & Container Frames */
QMainWindow {
    background-color: #f1f1f1; 
}

QFrame#rSidebar {
    background-color: #FFFFFF; 
    border-radius: 6px;        
    border: 1px solid #E0E4E8; 
}

/* Header Banner */
QFrame#Banner {
    background-color: #FFFFFF; 
    border-radius: 6px;        
    border: 1px solid #E0E4E8; 
}

QLabel#Logo {
    background-color: transparent;
    color: #212529;             
    font-size: 20px;            
    font-weight: bold;
    border-radius: 4px;
    border: none;  
}

QLabel#bannerTitle {
    color: #212529;             
    font-size: 20px;            
    font-weight: bold;
    background: transparent;    
    border: none;
}

QFrame#bannerBox {
    background-color: #FFFFFF; 
    border: 1px solid #E0E4E8; 
    border-radius: 4px;        
}

QLabel#lblC {
    color: #6C757D;            
    font-size: 11px;            
    background: transparent;    
    border: none;
}

/* Map Filter Controls */
QLabel#mapFilter {
    color: #212529;            
    font-size: 14px;            
    font-weight: bold;
    border: none;
}

QPushButton#viewAll {
    background-color: #E9ECEF; 
    color: #495057;            
    font-weight: bold;
    padding: 6px 14px;
    border-radius: 4px;
    border: none;
}

QPushButton#viewAll:hover {
    background-color: #DEE2E6; 
}

QPushButton#viewAvail {
    background-color: #E8F5E9; 
    color: #198754;            
    font-weight: bold;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #198754; 
}

QPushButton#viewAvail:hover {
    background-color: #DEE2E6;
}

QPushButton#viewOcc {
    background-color: #FFEBEE; 
    color: #DC3545;            
    font-weight: bold;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #DC3545; 
}

QPushButton#viewOcc:hover {
    background-color: #DEE2E6;
}

/* Map Grid & Parking Cards */
QScrollArea#scrollArea {
    border: 1px solid #E0E4E8;   
    border-radius: 6px;          
    background-color: #F8F9FA;  
}

QFrame#frame {
    background-color: #FFFFFF;   
    border-radius: 8px;          
    border: 1px solid #E0E4E8;   
}

QFrame#slotCard {
    background-color: #FFFFFF;   
    border: 1px solid #E0E4E8;   
    border-radius: 4px;          
}

QPushButton#action {
    background-color: #E9ECEF;
    color: #000000;
    font-size: 10px;
    border-radius: 3px;
    padding: 3px 6px;
    border: none;
}

QPushButton#action::hover {
    background-color: #DEE2E6;
    color: #000000;
    font-size: 10px;
    border-radius: 2px;
    padding: 2px;
    border: none;
}

QFrame#roadway {
    background-color: #ffffff;
    border-top: 1px dashed #ECEFF1;
    border-bottom: 1px dashed #ECEFF1;
}

/* Control Tabs */
QTabWidget::pane {
    border: 1px solid #E0E4E8;  
    background: #FFFFFF;      
    border-radius: 4px;         
}

QTabBar::tab {
    background: #F8F9FA;        
    color: #6C757D;             
    padding: 8px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    border: 1px solid #E0E4E8; 
    border-bottom: none; 
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #2B3036;
    font-weight: bold;
    border-top: 2px solid #316DCA;
}

/* Input Fields & Combos */
QLineEdit#panelInput, QComboBox#panelCombo {
    background-color: #FFFFFF; 
    color: #212529;            
    border: 1px solid #CED4DA; 
    padding: 6px;
    border-radius: 4px;        
}

QLineEdit#panelInput:focus, QComboBox#panelCombo:focus {
    border: 1px solid #0D6EFD; 
}

QSpinBox#panelSpin {
    background-color: #FFFFFF; 
    color: #212529;            
    padding: 6px;
    border: 1px solid #CED4DA; 
    border-radius: 4px;        
}

QSpinBox#panelSpin:focus {
    border: 1px solid #0D6EFD; 
}

QCheckBox#overstay {
    color: #ADBAC7;
    font-size: 11px;
}

QPushButton#assign {
    background-color: #E9ECEF; 
    color: #495057;            
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;        
    margin-top: 5px;
    border: none;
}

QPushButton#assign:hover {
    background-color: #DEE2E6; 
}

QLabel#section {
    color: #212529;            
    font-size: 14px;            
    font-weight: bold;
    border: none;
}

/* Smaller QLabel custom */
QLabel#sub_section {
    color: #6C757D;             
    font-size: 12px;        
    border: none;
}

/* NEW QPushButton */
QPushButton#Theme {
    background: transparent;   
    border: none;
    padding: 4px 8px;
    font-size: 20px;
}

QPushButton#Theme:hover {
    background-color: #F8F9FA;
    border-radius: 4px;            
}

QFrame#rate {
    background-color: #FFFFFF; 
    border: 1px solid #E0E4E8; 
    border-radius: 4px;        
}

QPushButton#checkoutBtn {
    background-color: #E9ECEF; 
    color: #495057;            
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;       
    margin-top: 5px;
    border: none;
}

QPushButton#checkoutBtn:hover {
    background-color: #DEE2E6; 
}

/* Session History Matrix */
QTableWidget#ticketLog {
    background-color: #FFFFFF; 
    color: #212529;            
    gridline-color: #E0E4E8;   
    font-size: 11px;
    border: 1px solid #E0E4E8; 
}

QHeaderView::section {
    background-color: #F8F9FA; 
    color: #212529;            
    padding: 6px;
    border-right: 1px solid #E0E4E8; 
    border-bottom: 1px solid #E0E4E8;
    font-size: 11px;
    font-weight: bold;
}

/* Activity Log */
QLabel#logTitle {
    color: #212529;             
    font-size: 14px;            
    font-weight: bold;
    border: none;
    padding-top: 5px;
}

QTextEdit#activityLogBox {
    background-color: #F8F9FA; 
    color: #198754;            
    border: 1px solid #E0E4E8; 
    font-family: monospace;     
    font-size: 12px;
    border-radius: 4px;
    padding: 4px;
}

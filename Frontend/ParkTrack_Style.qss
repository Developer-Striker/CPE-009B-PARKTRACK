/* Application & Container Frames */
QMainWindow {
    background-color: #22272E;
}

QFrame#rSidebar {
    background-color: #2B3036;
    border-radius: 6px;
    border: 1px solid #373E47;
}

/* Header Banner */
QFrame#Banner {
    background-color: #2B3036;
    border-radius: 6px;
    border: 1px solid #373E47;
}

QLabel#Logo {
    background-color: transparent;
    color: transparent;
    font-size: 20px;
    font-weight: bold;
    border-radius: 4px;
    border: 1px solid yellow;
}

QLabel#bannerTitle {
    color: #CDD9E5;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
    border: none;
}

QFrame#bannerBox {
    background-color: #1C2128;
    border: 1px solid #373E47;
    border-radius: 4px;
}

QLabel#lblC {
    color: #ADBAC7;
    font-size: 11px;
    background: transparent;
    border: none;
}

/* Map Filter Controls */
QLabel#mapFilter {
    color: #CDD9E5;
    font-size: 14px;
    font-weight: bold;
    border: none;
}

QPushButton#viewAll {
    background-color: #373E47;
    color: #CDD9E5;
    font-weight: bold;
    padding: 6px 14px;
    border-radius: 4px;
    border: none;
}

QPushButton#viewAvail {
    background-color: #57AB5A;
    color: #FFFFFF;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: none;
}

QPushButton#viewOcc {
    background-color: #E5534B;
    color: #ffffff;
    font-weight: bold;
    padding: 6px 14px;
    border-radius: 4px;
    border: none;
}

/* Map Grid & Parking Cards */
QScrollArea#scrollArea {
    border: 1px solid #373E47;
    border-radius: 6px;
    background-color: #1C2128;
}

QFrame#frame {
    background-color: #1C2128;
    border: none;
}

QFrame#slotCard {
    background-color: #2B3036;
    border: 1px solid #373E47;
    border-radius: 4px;
}

QPushButton#action {
    background-color: #373E47;
    color: #ADBAC7;
    font-size: 10px;
    border-radius: 3px;
    padding: 3px 6px;
    border: none;
}

QFrame#roadway {
    background-color: #181B20;
    border-top: 1px dashed #545D68;
    border-bottom: 1px dashed #545D68;
}

/* Control Tabs */
QTabWidget::pane {
    border: 2px solid #373E47;
    background: #2B3036;
    border-radius: 4px;
}

QTabBar::tab {
    background: #22272E;
    color: #768390;
    padding: 8px 14px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    border: 1px solid #373E47;
}

QTabBar::tab:selected {
    background: #2B3036;
    color: #CDD9E5;
    font-weight: bold;
    border-top: 2px solid #316DCA;
}

/* Input Fields & Combos */
QLineEdit#panelInput, QComboBox#panelCombo {
    background-color: #1C2128;
    color: #ADBAC7;
    border: 1px solid #373E47;
    padding: 6px;
    border-radius: 4px;
}

QSpinBox#panelSpin {
    background-color: #1C2128;
    color: #ADBAC7;
    padding: 6px;
    border: 1px solid #373E47;
    border-radius: 4px;
}

QCheckBox#overstay {
    color: #ADBAC7;
    font-size: 11px;
}

QPushButton#assign {
    background-color: #316DCA;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;
    margin-top: 5px;
    border: none;
}

QLabel#section {
    color: #CDD9E5;
    font-size: 14px;
    font-weight: bold;
    border: none;
}

/* Smaller QLabel custom */
QLabel#sub_section {
    color: #6CB6FF;
    font-size: 12px;
    border: none;
}

/* NEW QPushButton */
QPushButton#Theme {
    background: transparent;
    background-color: transparent;
    border: none;
    padding: 4px 8px;
    font-size: 20px;
}

QFrame#rate {
    background-color: #22272E;
    border: 1px solid #373E47;
    border-radius: 4px;
}

QPushButton#checkoutBtn {
    background-color: #316DCA;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;
    margin-top: 5px;
    border: none;
}

/* Session History Matrix */
QTableWidget#ticketLog {
    background-color: #1C2128;
    color: #ADBAC7;
    gridline-color: #2E343;
    font-size: 11px;
    border: 1px solid #373E47;
    border-radius: 4px;
}

QHeaderView::section {
    background-color: ##2B3036;
    color: #ADBAC7;
    padding: 6px;
    border: 1px solid #373E47;
    font-size: 11px;
}

/* Activity Log */
QLabel#logTitle {
    color: #CDD9E5;
    font-size: 14px;
    font-weight: bold;
    border: none;
    padding-top: 5px;
}

QTextEdit#activityLogBox {
    background-color: #1C2128;
    color: #57AB5A;
    border: 1px solid #373E47;
    font-family: JetBrains Mono;
    font-size: 12px;
    border-radius: 4px;
    padding: 4px;
}

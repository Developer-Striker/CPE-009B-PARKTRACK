/* Application & Container Frames */
QMainWindow {
    background-color: #2d2d30;
}

QFrame#rSidebar {
    background-color: #3e3e42;
    border-radius: 6px;
    border: 1px solid #555555;
}

/* Header Banner */
QFrame#Banner {
    background-color: #3e3e42;
    border-radius: 6px;
    border: 1px solid #555555;
}

QLabel#Logo {
    background-color: #1e1e1e;
    color: #f1c40f;
    font-size: 20px;
    font-weight: bold;
    border-radius: 4px;
    border: 1px solid yellow;
}

QLabel#bannerTitle {
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
    border: none;
}

QFrame#bannerBox {
    background-color: #1e1e1e;
    border: 1px solid #555555;
    border-radius: 4px;
}

QLabel#lblC {
    color: #aaaaaa;
    font-size: 10px;
    background: transparent;
    border: none;
}

/* Map Filter Controls */
QLabel#mapFilter {
    color: #aaaaaa;
    font-size: 12px;
    font-weight: bold;
    border: none;
}

QPushButton#viewAll {
    background-color: #7f8c8d;
    color: #ffffff;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: none;
}

QPushButton#viewAvail {
    background-color: #8EDFB0;
    color: #ffffff;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: none;
}

QPushButton#viewOcc {
    background-color: #e74c3c;
    color: #ffffff;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 3px;
    border: none;
}

/* Map Grid & Parking Cards */
QScrollArea#scrollArea {
    border: 1px solid #555555;
    border-radius: 6px;
    background-color: #1e1e1e;
}

QFrame#frame {
    background-color: #1e1e1e;
    border: none;
}

QFrame#slotCard {
    background-color: #2d2d30;
    border: 1px solid #444444;
    border-radius: 4px;
}

QPushButton#action {
    background-color: #555555;
    color: #ffffff;
    font-size: 10px;
    border-radius: 2px;
    padding: 2px;
    border: none;
}

QFrame#roadway {
    background-color: #282828;
    border-top: 1px dashed #777777;
    border-bottom: 1px dashed #777777;
}

/* Control Tabs */
QTabWidget::pane {
    border: 2px solid #555555;
    background: #3e3e42;
    border-radius: 4px;
}

QTabBar::tab {
    background: #2d2d30;
    color: #aaaaaa;
    padding: 8px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    border: 1px solid #555555;
}

QTabBar::tab:selected {
    background: #555555;
    color: #ffffff;
    font-weight: bold;
    border-bottom-color: transparent;
}

/* Input Fields & Combos */
QLineEdit#panelInput, QComboBox#panelCombo {
    background-color: #555;
    color: white;
    border: 1px solid #777;
    padding: 5px;
    border-radius: 3px;
}

QSpinBox#panelSpin {
    background-color: #555555;
    color: #ffffff;
    padding: 3px;
    border: 1px solid #777777;
    border-radius: 3px;
}

QCheckBox#overstay {
    color: #aaa;
    font-size: 11px;
}

QPushButton#assign {
    background-color: #2980b9;
    color: #ffffff;
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;
    margin-top: 5px;
    border: none;
}

QLabel#Allocation {
    color: #f1c40f;
    font-size: 13px;
    font-weight: bold;
    border: none;
}

QLabel#section {
    color: #e74c3c;
    font-size: 13px;
    font-weight: bold;
    border: none;
}

QFrame#rate {
    background-color: #2d2d30;
    border: 1px solid #555555;
    border-radius: 4px;
}

QPushButton#checkoutBtn {
    background-color: #e74c3c;
    color: #ffffff;
    font-weight: bold;
    padding: 8px;
    border-radius: 4px;
    margin-top: 5px;
    border: none;
}

/* Session History Matrix */
QTableWidget#ticketLog {
    background-color: #1e1e1e;
    color: #ffffff;
    gridline-color: #444444;
    font-size: 11px;
    border: 1px solid #555555;
}

QHeaderView::section {
    background-color: #3e3e42;
    color: #ffffff;
    padding: 4px;
    border: 1px solid #555555;
    font-size: 11px;
}

/* Activity Log */
QLabel#logTitle {
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    border: none;
    padding-top: 5px;
}

QTextEdit#activityLogBox {
    background-color: #0D1117;
    color: #8EDFB0;
    border: 1px solid #555555;
    font-family: JetBrains Mono;
    font-size: 14px;
    border-radius: 4px;
}


